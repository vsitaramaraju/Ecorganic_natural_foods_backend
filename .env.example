# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/eco_organic_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (main site address; used for CORS and links in emails)
FRONTEND_URL=http://localhost:5173
# Optional: other addresses allowed to call the API, comma-separated
# CORS_EXTRA_ORIGINS=https://www.ecorganic.store

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@ecoorganicfoods.com

# Server Configuration
PORT=5000
NODE_ENV=development

# Optional: For development testing
TEST_EMAIL=test@example.com

# Razorpay (online payments + refunds). Get keys from https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_. Leave empty to offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type when adding the webhook in Razorpay Dashboard -> Settings -> Webhooks.
# Webhook URL: https://<your-backend-domain>/api/payments/razorpay/webhook
# Events: payment.authorized, payment.captured, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=d45a75aad5de0a1780ecc22c9cf251f2d6e3e5fc3729a29a18edc
